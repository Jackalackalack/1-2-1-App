# ── Google Calendar (use /api/availability and /api/book) ────────────────────
# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match a redirect URI you added to that OAuth client.
# Local dev:
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback
# Production (once deployed):
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/oauth/callback
GOOGLE_REDIRECT_URI=

# Leave blank at first. You get this by visiting /api/oauth once,
# signing in, then copying the value shown on the callback page.
GOOGLE_REFRESH_TOKEN=


# ── Microsoft / Outlook Calendar (use /api/ms-availability and /api/ms-book) ─
# From Azure Portal > App registrations > your app > Overview (Application ID)
# and Certificates & secrets > New client secret.
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Your Azure AD tenant ID (found in Azure Portal > Azure Active Directory > Overview).
# Use "common" to support any Microsoft account (personal or work/school).
MS_TENANT_ID=common

# Must exactly match a redirect URI registered under your app > Authentication.
# Local dev:
# MS_REDIRECT_URI=http://localhost:3000/api/ms-oauth/callback
# Production (once deployed):
# MS_REDIRECT_URI=https://your-app.vercel.app/api/ms-oauth/callback
MS_REDIRECT_URI=

# Leave blank at first. You get this by visiting /api/ms-oauth once,
# signing in with your Microsoft account, then copying the value shown.
MS_REFRESH_TOKEN=

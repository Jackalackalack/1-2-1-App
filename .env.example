# From Google Cloud Console > APIs & Services > Credentials (OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match a redirect URI you added to that OAuth client.
# Local dev:
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/callback
# Production (once deployed):
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/oauth/callback
GOOGLE_REDIRECT_URI=

# Leave blank at first. You get this by visiting /api/oauth once,
# signing in, then copying the value shown on the callback page.
GOOGLE_REFRESH_TOKEN=
